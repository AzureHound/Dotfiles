# Configs
set $config  ~/.config/sway/configs
set $scripts ~/.config/sway/scripts

# Source
include $config/apps.conf
include $config/input.conf
include $config/binds.conf
include $config/monitors.conf
# include $config/swaybar.conf
include $config/workspaces.conf

# Theme
include ~/.config/sway/theme/theme.conf

# Autostart
exec_always $scripts/autostart/apps
exec_always $scripts/autostart/services

include /etc/sway/config.d/*
