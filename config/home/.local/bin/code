#!/usr/bin/env bash

# Catppuccin Macchiato
ROSEWATER="\e[38;2;244;219;214m" # #f4dbd6
FLAMINGO="\e[38;2;240;198;198m"  # #f0c6c6
PINK="\e[38;2;245;189;230m"      # #f5bde6
MAUVE="\e[38;2;198;160;246m"     # #c6a0f6
RED="\e[38;2;237;135;150m"       # #ed8796
MAROON="\e[38;2;238;153;160m"    # #ee99a0
PEACH="\e[38;2;245;169;127m"     # #f5a97f
YELLOW="\e[38;2;238;212;159m"    # #eed49f
GREEN="\e[38;2;166;218;149m"     # #a6da95
TEAL="\e[38;2;139;213;202m"      # #8bd5ca
SKY="\e[38;2;145;215;227m"       # #91d7e3
SAPPHIRE="\e[38;2;125;196;228m"  # #7dc4e4
BLUE="\e[38;2;138;173;244m"      # #8aadf4
LAVENDER="\e[38;2;183;189;248m"  # #b7bdf8
TEXT="\e[38;2;202;211;245m"      # #cad3f5
SUBTEXT1="\e[38;2;184;192;224m"  # #b8c0e0
SUBTEXT0="\e[38;2;165;173;203m"  # #a5adcb
OVERLAY2="\e[38;2;147;154;183m"  # #939ab7
OVERLAY1="\e[38;2;128;135;162m"  # #8087a2
OVERLAY0="\e[38;2;110;115;141m"  # #6e738d
SURFACE2="\e[38;2;91;96;120m"    # #5b6078
SURFACE1="\e[38;2;73;77;100m"    # #494d64
SURFACE0="\e[38;2;54;58;79m"     # #363a4f
BASE="\e[38;2;36;39;58m"         # #24273a
MANTLE="\e[38;2;30;32;48m"       # #1e2030
CRUST="\e[38;2;24;25;38m"        # #181926
RESET="\e[0m"

if [[ $# -eq 0 ]]; then
  cmd="${GREEN}$(basename "$0")${RESET} ${BLUE}"
  echo -e "${YELLOW}Usage:${RESET}"
  echo -e "  ${cmd}init${RESET}            ${OVERLAY1}Initialize git remotes${RESET}"
  echo -e "  ${cmd}push${RESET}            ${OVERLAY1}Push to all configured remotes${RESET}"
  echo -e "  ${cmd}push --force${RESET}    ${OVERLAY1}Force push to all configured remotes${RESET}"
  exit 0
fi

# Remote
remote_exists() {
  git remote get-url "$1" &>/dev/null
}

# Init
if [[ "$1" == "init" ]]; then
  folder="${PWD##*/}"

  for rem in $(git remote); do
    url=$(git remote get-url "$rem")
    if [[ "$url" == *"AzureHound"* ]]; then
      if [[ "$url" == *"github.com"* && "$rem" != "github" ]]; then
        git remote rename "$rem" github 2>/dev/null || true
      elif [[ "$url" == *"codeberg.org"* && "$rem" != "codeberg" ]]; then
        git remote rename "$rem" codeberg 2>/dev/null || true
      elif [[ "$url" == *"forgejo"* && "$rem" != "forgejo" ]]; then
        git remote rename "$rem" forgejo 2>/dev/null || true
      elif [[ "$url" == *"gitlab.com"* && "$rem" != "gitlab" ]]; then
        git remote rename "$rem" gitlab 2>/dev/null || true
      fi
    fi
  done

  for r in \
    "codeberg git@codeberg.org:AzureHound/${folder}.git" \
    "forgejo git@forgejo.softshell.duckdns.org:AzureHound/${folder}.git" \
    "github git@github.com:AzureHound/${folder}.git" \
    "gitlab git@gitlab.com:AzureHound/${folder}.git"; do
    read -r name url <<<"$r"
    git remote add "$name" "$url" 2>/dev/null || git remote set-url "$name" "$url"
  done

  branch=$(git branch --show-current 2>/dev/null)
  if [[ -n "$branch" ]] && remote_exists "github"; then
    git config "branch.${branch}.remote" github
    git config "branch.${branch}.merge" "refs/heads/${branch}"
  fi

  echo -e "${GREEN}Remotes configured for project: ${BLUE}${folder}${RESET}"
  exit 0
fi

if [[ "$1" == "push" ]]; then
  # FORCE
  FORCE=""
  [[ "$2" == "--force" ]] && FORCE="--force"

  # Objects Compression
  git gc --auto

  # Codeberg
  if remote_exists "codeberg"; then
    echo -e "\n${OVERLAY2}Codeberg ${BLUE} ${RESET}\n"
    timeout 30s git push codeberg $FORCE
  fi

  # Forgejo
  if remote_exists "forgejo"; then
    echo -e "\n${OVERLAY2}Forgejo ${RED} ${RESET}\n"
    timeout 30s git push forgejo $FORCE
  fi

  # GitHUB
  if remote_exists "github"; then
    echo -e "\n${OVERLAY2}GitHUB ${SUBTEXT1} ${RESET}\n"
    timeout 30s git push github $FORCE
  fi

  # GitLAB
  if remote_exists "gitlab"; then
    echo -e "\n${OVERLAY2}GitLAB ${PEACH} ${RESET}\n"
    timeout 30s git push gitlab $FORCE
  fi
fi
